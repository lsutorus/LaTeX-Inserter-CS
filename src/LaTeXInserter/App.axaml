<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LaTeXInserter.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="AccentBgBrush" Color="#404040" Opacity="0.25" />
        <SolidColorBrush x:Key="SystemAccentBrush" Color="#404040" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Shared dialog button styles -->
        <Style Selector="Button.dialog-ok">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style Selector="Button.dialog-ok:pointerover">
            <Setter Property="Background" Value="#388E3C" />
        </Style>
        <Style Selector="Button.dialog-install">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="Button.dialog-install:pointerover">
            <Setter Property="Background" Value="#1976D2" />
        </Style>
        <Style Selector="Button.dialog-later">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#aaaaaa" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <!-- Hotkey dialog chord display states -->
        <Style Selector="TextBlock.recording-only">
            <Setter Property="Foreground" Value="#666666" />
        </Style>
        <Style Selector="TextBlock.valid">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.blocked">
            <Setter Property="Foreground" Value="#FFB74D" />
        </Style>

        <!-- Accent color swatch styles -->
        <Style Selector="Border.accent-ring">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.accent-ring:pointerover">
            <Setter Property="BorderBrush" Value="#888888" />
        </Style>
        <Style Selector="Border.accent-ring.accent-selected">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Border.accent-ring.accent-selected:pointerover">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Button.accent-swatch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Neutralize Fluent button pointerover/pressed on swatch so no rogue border/background shifts the swatch -->
        <Style Selector="Button.accent-swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.accent-swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- System Tray Menu styles (Razer Synapse style) -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="MinWidth" Value="180" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#323232" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem /template/ Viewbox#PART_IconPresenter">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="MenuFlyoutPresenter Separator">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,3" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="LaTeX Inserter" />
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
